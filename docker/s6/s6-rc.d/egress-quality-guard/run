#!/command/with-contenv sh
set -eu

BOOTSTRAP="/var/lib/grok2api-quality-guard/bootstrap.json"
HEALTH_URL="http://127.0.0.1:8000/healthz"

# Wait for grok2api to write bootstrap and become healthy
until [ -s "$BOOTSTRAP" ] && wget -qO- "$HEALTH_URL" >/dev/null 2>&1; do
  sleep 2
done

# Run guard; restart on crash, stay down on clean exit (disabled)
while :; do
  su-exec "${PUID}:${PGID}" /usr/local/bin/grok2api-egress-quality-guard
  code=$?
  [ "$code" -eq 0 ] && exit 0
  echo "egress quality guard exited ($code); restarting in 10s" >&2
  sleep 10
done
